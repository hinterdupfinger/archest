{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "pnpm run download-fonts && pnpm run typedoc && docusaurus start",
    "build": "pnpm run download-fonts && pnpm run typedoc && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "typedoc": "pnpm run typedoc:vitest && pnpm run typedoc:jest",
    "typedoc:vitest": "typedoc --plugin typedoc-plugin-markdown --entryPoints ../packages/vitest/src/index.ts --tsconfig ../packages/vitest/tsconfig.json --out docs/api/vitest --name \"@archest/vitest\" --cleanOutputDir false",
    "typedoc:jest": "typedoc --plugin typedoc-plugin-markdown --entryPoints ../packages/jest/src/index.ts --tsconfig ../packages/jest/tsconfig.json --out docs/api/jest --name \"@archest/jest\" --cleanOutputDir false",
    "download-fonts": "node scripts/download-fonts.js"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@archest/core": "workspace:*",
    "@archest/jest": "workspace:*",
    "@archest/vitest": "workspace:*",
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
