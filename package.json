{
  "name": "archest-monorepo",
  "private": true,
  "version": "1.0.0",
  "repository": "https://github.com/hinterdupfinger/archest",
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check --write .",
    "build": "pnpm --filter @archest/vitest build",
    "test": "pnpm --filter @archest/vitest test && pnpm --filter basic-usage test",
    "docs:build": "pnpm --filter docs build",
    "docs:start": "pnpm --filter docs start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14"
  }
}
